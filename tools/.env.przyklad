# Wzór pliku tools/.env - skopiuj jako tools/.env i uzupełnij.
# Sam .env jest w .gitignore i nigdy nie trafia do repozytorium.

NTC_SITE=https://ntc-strona.salescons.pl

# Login użytkownika WordPressa z prawami administratora.
NTC_USER=

# Hasło aplikacji z Użytkownicy → Profil → Hasła aplikacji.
# Spacje w środku nie przeszkadzają.
NTC_APP_PASS=

# Wartość stałej NTC_DEPLOY_KEY z wp-config.php, minimum 20 znaków.
NTC_DEPLOY_KEY=
